rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){ return request.auth != null; }
    function me(){ return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function active(){ return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && me().data.get('active', true) != false; }
    function role(r){ return active() && me().data.get('role', '') == r; }
    function staff(){ return role('STORE') || role('DRIVER'); }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || role('STORE'));
      allow create, update, delete: if role('STORE');
    }
    match /shipments/{shipmentId} {
      allow read: if staff();
      allow create, update, delete: if role('STORE');
      match /deliveries/{deliveryId} {
        allow read: if staff();
        allow create, delete: if role('STORE');
        allow update: if role('STORE') || role('DRIVER');
      }
    }
    match /driverLocations/{driverId} {
      allow read: if staff();
      allow write: if role('DRIVER') && request.auth.uid == driverId;
      // Store deletion removes a stop from an existing private route manifest.
      allow update: if role('STORE') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['routeEntries']);
    }
    match /tracking/{trackingCode} {
      // A client may open its secret link, never enumerate other customers.
      allow get: if true;
      allow list: if false;
      allow create, update: if staff();
      allow delete: if role('STORE');
    }
  }
}
