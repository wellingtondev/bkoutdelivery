{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "blackout-delivery": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/blackout-delivery",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "src/styles.css"
            ],
            "outputHashing": "all"
          },
          "configurations": {
            "test-preview": {
              "browser": "tests/visual/main.ts",
              "tsConfig": "tests/visual/tsconfig.json",
              "outputPath": "dist/test-preview",
              "optimization": false,
              "sourceMap": true
            },
            "production": {
              "optimization": true,
              "sourceMap": false
            }
          }
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "blackout-delivery:build:production"
            },
            "development": {
              "buildTarget": "blackout-delivery:build"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
